# ─────────────────────────────────────────────────────────────
#  tamilvazhi-api — environment
#  Local: copy to .env.  Dokploy: paste into the Environment tab.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ---- MongoDB -------------------------------------------------
# Local (docker compose up -d):
MONGODB_URI="mongodb://tamilvazhi:tamilvazhi@localhost:27018/tamilvazhi?authSource=admin"
# Dokploy (internal service hostname, never expose Mongo publicly):
# MONGODB_URI="mongodb://tamilvazhi:STRONG_PASSWORD@tamilvazhi-mongo:27017/tamilvazhi?authSource=admin"

# ---- Auth ----------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seeded on every boot — this IS the live instructor login.
ADMIN_EMAIL="instructor@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_NAME="Course Instructor"

# ---- Cross-origin / cookies ----------------------------------
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS="http://localhost:3000"

# Where to send a student who opens a gated file link directly.
FRONTEND_URL="http://localhost:3000"

# Production with subdomains (portal.yoursite.com + api.yoursite.com):
#   COOKIE_DOMAIN=".yoursite.com"   <- leading dot, shares the cookie
#   COOKIE_SAMESITE="lax"
#   COOKIE_SECURE="true"
# Leave COOKIE_DOMAIN blank on localhost — browsers reject a Domain attribute
# on a bare hostname and the login cookie would silently never be stored.
COOKIE_DOMAIN=""
COOKIE_SAMESITE="lax"
COOKIE_SECURE="false"

# ---- Object storage (S3-compatible) --------------------------
# Local MinIO from docker-compose:
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="tamilvazhi"
S3_ACCESS_KEY_ID="tamilvazhiadmin"
S3_SECRET_ACCESS_KEY="tamilvazhiadmin"
S3_FORCE_PATH_STYLE="true"

# Cloudflare R2 (recommended in production — zero egress fees):
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="tamilvazhi"
# S3_ACCESS_KEY_ID="<r2 access key id>"
# S3_SECRET_ACCESS_KEY="<r2 secret access key>"
# S3_FORCE_PATH_STYLE="false"

# How long a playback link stays valid (seconds).
SIGNED_URL_TTL="21600"
